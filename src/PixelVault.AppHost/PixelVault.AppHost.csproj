    <ProjectReference Include="..\PixelVault.Payment.Api\PixelVault.Payment.Api.csproj" />
    <ProjectReference Include="..\PixelVault.Shipping.Api\PixelVault.Shipping.Api.csproj" />
    <ProjectReference Include="..\PixelVault.Identity.Api\PixelVault.Identity.Api.csproj" />
  </ItemGroup>

</Project>
