{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentDb": "Data Source=App_Data/payment.db"
  },
  "Database": {
    "ResetOnStartup": true
  },
  "TestSupport": {
    "Enabled": false
  },
  "FaultInjection": {
    "FailureRate": 0.0,
    "ExtraLatencyMilliseconds": 0
  }
}
